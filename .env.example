# ───────── Discord ─────────
# Create a bot at https://discord.com/developers/applications
# and enable "Message Content Intent" on the Bot page.
DISCORD_TOKEN=
# Default prefix (servers with a custom prefix stored in db/prefix.db keep theirs)
BOT_PREFIX=.

# ───────── FFmpeg / yt-dlp (music engine) ─────────
# FFmpeg must be installed. Blank = use `ffmpeg` from PATH.
FFMPEG_PATH=
# OPTIONAL and NOT needed. The bot already gets around YouTube's bot check by itself (client fallback + SoundCloud).
# Leave blank unless you have a cookies.txt and want age-restricted videos.
YTDL_COOKIEFILE=

# ───────── Optional ─────────
# Comma-separated Discord user IDs of the bot owners: they can use owner-only commands (np, forcefix, forcequit...).
# Blank = the application owner from the Developer Portal. Example: OWNER_IDS=123456789012345678,987654321098765432
OWNER_IDS=
# ENABLE_JISHAKU: owner-only debug cog that can run code on this machine.
# Leave it off unless you need it.
ENABLE_JISHAKU=false
# Seconds alone in a voice channel before the bot leaves
INACTIVITY_TIMEOUT=120
# Register slash commands on startup
SYNC_COMMANDS=true
# Blank = automatic sharding
SHARD_COUNT=
# Tiny web server for hosts that need an open port (needs flask)
KEEP_ALIVE=false
PORT=8080
# Optional: lets the bot read Spotify links (it looks the tracks up and plays the matching YouTube audio)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
